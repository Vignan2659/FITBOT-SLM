# Copy to backend/.env (setup.sh does this and generates JWT_SECRET). Every value is optional; defaults are shown.
# IMPORTANT: use a long random JWT_SECRET, e.g.  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite:///./fitbot.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Fine-tuned model created by scripts/setup_model.py. Relative paths are resolved from the project root.
# If it is missing, the base model is used and /health reports "fine_tuned": false.
FITBOT_MODEL_PATH=models/fitbot-qwen3-4b/merged
FITBOT_BASE_MODEL=Qwen/Qwen3-4B-Instruct-2507
FITBOT_DEVICE=auto            # auto | mps | cpu | cuda
FITBOT_DTYPE=auto             # auto (mps: float16) | bfloat16 | float32 - try bfloat16 if answers look garbled
FITBOT_MAX_NEW_TOKENS=220
FITBOT_REPETITION_PENALTY=1.05
FITBOT_HISTORY_TURNS=1
FITBOT_EXERCISES_FILE=exercises/exercises_v2.json   # all 871 exercises; exercises/exercises.json = 58 curated
FITBOT_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
FITBOT_USE_EMBEDDINGS=true
