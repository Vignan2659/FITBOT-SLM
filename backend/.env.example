# Copy to backend/.env and adjust. All values are optional; defaults are shown.
# IMPORTANT: set a long random JWT_SECRET (e.g. python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite:///./fitbot.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Fine-tuned model exported by training/FitBot_FineTuning.ipynb (installed with scripts/install_model.py).
# Relative paths are resolved from the project root. If it is missing, the base model below is used
# and /health reports "fine_tuned": false.
FITBOT_MODEL_PATH=models/fitbot-smollm2-360m-lora/merged
FITBOT_BASE_MODEL=HuggingFaceTB/SmolLM2-360M-Instruct
FITBOT_DEVICE=auto            # auto | cpu | mps | cuda
FITBOT_MAX_NEW_TOKENS=220
FITBOT_HISTORY_TURNS=1
FITBOT_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
FITBOT_USE_EMBEDDINGS=true
